---
import { ArrowUpRight, ExternalLink } from 'lucide-astro';
import type { Project } from '../data/projects';
import VerticePreview from './VerticePreview.astro';
const { project, compact = false } = Astro.props as { project: Project; compact?: boolean };
---
<article class:list={['project-card', { compact }]}>
  <a class="project-image" href={`/projetos/${project.slug}`} aria-label={`Conhecer o case ${project.name}`}>
    {project.slug === 'vertice' ? <VerticePreview /> : project.image ? <img src={project.image} alt={`Captura da interface do projeto ${project.name}`} width="900" height="480" loading="lazy" decoding="async" /> : <div class="project-preview-pending"><span>Imagem em preparação</span><strong>{project.name}</strong></div>}
  </a>
  <div class="project-content">
    <p class="project-category">{project.category}</p>
    <h3>{project.name}</h3>
    <p>{project.shortDescription}</p>
    {project.status && <span class="project-status">{project.status}</span>}
    {!compact && <div class="chip-list">{project.technologies.slice(0, 3).map((tech) => <span>{tech}</span>)}</div>}
    <div class="project-card-actions">
      <a class="project-link" href={`/projetos/${project.slug}`}>Entender o case <ArrowUpRight size={17} /></a>
      {!compact && project.website && <a class="project-demo-link" href={project.website} target="_blank" rel="noopener noreferrer">Abrir projeto <ExternalLink size={15} /></a>}
    </div>
  </div>
</article>
