---
import { Menu, X } from 'lucide-astro';
const navItems = [
  ['Soluções', '#servicos'], ['Projetos', '#projetos'],
  ['Como trabalho', '#processo'], ['Sobre', '#sobre'],
];
const whatsapp = 'https://wa.me/5514996954298?text=' + encodeURIComponent('Olá, Felipe! Vi seu portfólio e gostaria de conversar sobre um projeto.');
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/#inicio" aria-label="Felipe Alves — início">FA<span>.</span></a>
    <button class="menu-button" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="site-nav" data-menu-button><Menu size={22} aria-hidden="true" data-menu-icon /><X size={22} aria-hidden="true" data-close-icon hidden /></button>
    <nav id="site-nav" class="site-nav" aria-label="Navegação principal" data-nav>
      <ul>{navItems.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
      <a class="button button-small" href={whatsapp} target="_blank" rel="noopener noreferrer" data-cta="header-orcamento">Conversar sobre meu projeto</a>
    </nav>
  </div>
</header>
