---
import { ArrowLeft, Check, ExternalLink, Github, MessageCircle } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, type Project } from '../../data/projects';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props as { project: Project };
const whatsapp = `https://wa.me/5514996954298?text=${encodeURIComponent(`Olá Felipe! Vi o projeto ${project.name} e gostaria de conversar sobre um projeto.`)}`;
const commercialCopy = project.audience === 'restaurante' ? 'Posso desenvolver uma solução personalizada para apresentar sua marca, cardápio e facilitar pedidos e contatos.' : 'Posso desenvolver uma solução personalizada para a necessidade do seu negócio.';
---
<BaseLayout title={`${project.name} | Projeto de Felipe Alves`} description={project.shortDescription} image={project.image}>
  <article class="case-page"><div class="container"><a class="back-link" href="/#projetos"><ArrowLeft size={17} /> Voltar aos projetos</a><header class="case-header"><p class="eyebrow">{project.category}</p><h1>{project.name}</h1><p>{project.description}</p>{project.status && <span class="status-label">{project.status}</span>}</header>
  <div class="case-visual">{project.image ? <img src={project.image} alt={`Prévia do projeto ${project.name}`} width="1200" height="650" /> : <div class:list={['project-placeholder', 'case-placeholder', project.slug]}><span>Preview conceitual</span><strong>{project.name}</strong><i></i><i></i><i></i></div>}</div>
  <div class="case-actions">{project.website && <a class="button" href={project.website} target="_blank" rel="noopener noreferrer"><ExternalLink size={18} /> Ver projeto ao vivo</a>}{project.github && <a class="button button-ghost" href={project.github} target="_blank" rel="noopener noreferrer"><Github size={18} /> GitHub</a>}</div>
  <div class="case-details"><section><h2>Desafio</h2><p>{project.problem ?? 'Criar uma experiência digital que apresente o projeto de forma clara e útil para o seu público.'}</p></section><section><h2>Solução</h2><p>{project.solution ?? 'Uma interface responsiva que organiza as informações e torna o contato mais simples.'}</p></section><section><h2>Principais recursos</h2><ul>{(project.highlights ?? ['Experiência responsiva', 'Informações organizadas', 'Interface orientada ao usuário']).map((highlight) => <li><Check size={17} /> {highlight}</li>)}</ul></section><section><h2>Tecnologias</h2><div class="chip-list">{project.technologies.map((tech) => <span>{tech}</span>)}</div></section></div></div>
  <section class="case-cta"><div class="container"><div><p class="eyebrow">Seu próximo projeto</p><h2>{project.audience === 'restaurante' ? 'Precisa de um site para seu restaurante?' : 'Precisa de uma solução como esta?'}</h2><p>{commercialCopy}</p></div><a class="button" href={whatsapp} target="_blank" rel="noopener noreferrer"><MessageCircle size={18} /> Solicitar orçamento</a></div></section></article>
</BaseLayout>
