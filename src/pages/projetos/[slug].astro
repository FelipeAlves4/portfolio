---
import { ArrowLeft, ArrowUpRight, Check, ExternalLink, Github, MessageCircle } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, type Project } from '../../data/projects';
import VerticePreview from '../../components/VerticePreview.astro';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props as { project: Project };
const whatsapp = 'https://wa.me/5514996954298?text=' + encodeURIComponent(`Olá, Felipe! Vi o case ${project.name} e gostaria de conversar sobre um projeto semelhante.`);
const commercialCopy = project.segment === 'sites' ? 'Também precisa de um site que apresente bem sua empresa e facilite o contato com clientes? Vamos conversar sobre o objetivo e o escopo.' : 'Precisa de um sistema com funcionalidades e regras próprias para seu negócio? Vamos conversar sobre a necessidade.';
---
<BaseLayout title={`${project.name} | Case de desenvolvimento - Felipe Alves`} description={project.shortDescription} image={project.image ?? '/images/projects/psigestao.png'}>
  <article class="case-page">
    <div class="container">
      <a class="back-link" href="/#projetos"><ArrowLeft size={17} /> Voltar aos projetos</a>
      <header class="case-header">
        <p class="eyebrow">{project.category}</p><h1>{project.name}</h1>
        <p>{project.description}</p>
        {project.status && <span class="status-label">{project.status}</span>}
      </header>
      <div class="case-visual">
        {project.slug === 'vertice' ? <VerticePreview /> : project.image ? <img src={project.image} alt={`Captura da interface de ${project.name}`} width="1200" height="650" /> : <div class="project-preview-pending case-preview-pending"><span>Captura em preparação</span><strong>{project.name}</strong></div>}
      </div>
      {project.slug === 'vertice' && <p class="case-editorial-note">Capa editorial do conceito visual da VÉRTICE. Veja a interface real e teste a loja pelo link abaixo.</p>}
      <div class="case-actions">
        {project.website && <a class="button" href={project.website} target="_blank" rel="noopener noreferrer"><ExternalLink size={18} /> Ver projeto ao vivo</a>}
        {project.github && <a class="button button-ghost" href={project.github} target="_blank" rel="noopener noreferrer"><Github size={18} /> Ver código no GitHub</a>}
      </div>
      <div class="case-story">
        <aside class="case-overview"><p class="eyebrow">Visão geral</p><dl><div><dt>Tipo de solução</dt><dd>{project.category}</dd></div><div><dt>Atuação</dt><dd>{project.role ?? 'Desenvolvimento web'}</dd></div>{project.status && <div><dt>Estado</dt><dd>{project.status}</dd></div>}</dl></aside>
        <div class="case-narrative">
          <section><p class="eyebrow">01 / Contexto</p><h2>O desafio</h2><p>{project.problem ?? 'Organizar as informações e oferecer uma experiência digital clara para seu público.'}</p></section>
          <section><p class="eyebrow">02 / Implementação</p><h2>A solução</h2><p>{project.solution ?? 'Construção de uma interface com navegação simples e apresentação objetiva das informações.'}</p></section>
          <section><p class="eyebrow">03 / O que foi desenvolvido</p><h2>Recursos e entregas</h2><ul class="case-highlights">{(project.highlights ?? ['Interface responsiva', 'Informações organizadas', 'Experiência voltada ao usuário']).map((highlight) => <li><Check size={18} /> <span>{highlight}</span></li>)}</ul></section>
          <section class="case-evidence"><p class="eyebrow">04 / Demonstração</p><h2>O que este case comprova</h2><p>{project.evidence ?? 'Apresenta o trabalho desenvolvido e seus recursos. Métricas comerciais de desempenho não foram divulgadas para este projeto.'}</p></section>
          <section><p class="eyebrow">Base técnica</p><h2>Tecnologias utilizadas</h2><div class="chip-list">{project.technologies.map((tech) => <span>{tech}</span>)}</div></section>
        </div>
      </div>
    </div>
    <section class="case-cta"><div class="container"><div><p class="eyebrow">Próximo projeto</p><h2>Precisa de algo parecido?</h2><p>{commercialCopy}</p></div><a class="button" href={whatsapp} target="_blank" rel="noopener noreferrer" data-cta="case-contato"><MessageCircle size={18} /> Conversar sobre um projeto <ArrowUpRight size={16} /></a></div></section>
  </article>
</BaseLayout>
