---
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
const featured = projects.filter((project) => project.featured);
const others = projects.filter((project) => !project.featured);
---
<section id="projetos" class="section projects-section"><div class="container"><div class="section-heading section-heading-left reveal"><p class="eyebrow">Trabalho selecionado</p><h2>Projetos que mostram como posso ajudar.</h2><p>Interfaces comerciais, experiências institucionais e produtos digitais para necessidades reais.</p></div><div class="projects-grid">{featured.map((project) => <FeaturedProject project={project} />)}</div><div class="other-projects"><div class="subheading reveal"><p>Mais projetos</p><span></span></div><div class="other-projects-grid">{others.map((project) => <ProjectCard project={project} compact />)}</div></div></div></section>
