---
import FeaturedProject from '../components/FeaturedProject.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
const featuredSystems = projects.filter((project) => project.featured && project.segment === 'sistemas');
const featuredSites = projects.filter((project) => project.featured && project.segment === 'sites');
const others = projects.filter((project) => !project.featured);
---
<section id="projetos" class="section projects-section">
  <div class="container">
    <div class="section-heading section-heading-left reveal">
      <p class="eyebrow">Portfólio selecionado</p>
      <h2>Conheça o trabalho por trás das soluções.</h2>
      <p>Cada case explica a necessidade, a solução desenvolvida e o que é possível avaliar no projeto. Sem promessas de resultados que não foram medidos.</p>
    </div>
    <div id="projetos-sistemas" class="project-category-block">
      <div class="project-category-heading"><div><p class="eyebrow">Sistemas e plataformas</p><h3>Da interface às regras do negócio.</h3></div><p>Fluxos, dados e funcionalidades pensados para o uso real.</p></div>
      <div class="projects-grid">{featuredSystems.map((project) => <FeaturedProject project={project} />)}</div>
    </div>
    <div id="projetos-sites" class="project-category-block">
      <div class="project-category-heading"><div><p class="eyebrow">Sites e presença digital</p><h3>Experiências que apresentam e aproximam.</h3></div><p>Identidade, conteúdo e caminhos de contato claros.</p></div>
      <div class="projects-grid">{featuredSites.map((project) => <FeaturedProject project={project} />)}</div>
    </div>
    <div class="other-projects">
      <div class="subheading reveal"><p>Outros trabalhos</p><span></span></div>
      <div class="other-projects-grid">{others.map((project) => <ProjectCard project={project} compact />)}</div>
    </div>
  </div>
</section>
