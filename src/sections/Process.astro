---
import { ClipboardList, Code2, MessageCircleMore, Rocket } from 'lucide-astro';
import ProcessStep from '../components/ProcessStep.astro';
const steps = [
  ['01', 'Entendimento', 'Conversamos sobre a necessidade, usuários e objetivos do projeto.', MessageCircleMore],
  ['02', 'Escopo e proposta', 'Definimos entregas, prioridades, prazo e critérios de aprovação.', ClipboardList],
  ['03', 'Desenvolvimento', 'Construção por etapas, com demonstrações e alinhamento de ajustes.', Code2],
  ['04', 'Validação e entrega', 'Testes, correções, publicação e orientações para uso da solução.', Rocket],
];
---
<section id="processo" class="section section-tint"><div class="container"><div class="section-heading reveal"><p class="eyebrow">Da ideia à entrega</p><h2>Um processo claro, sem surpresas desnecessárias.</h2><p>O formato e os marcos são ajustados ao tamanho e à complexidade do seu projeto.</p></div><div class="process-grid">{steps.map(([number, title, description, icon]) => <ProcessStep number={number} title={title} description={description} icon={icon} />)}</div></div></section>
